# Banderas del destino local (infra/servidor/banderas.tsv).
# Solo banderas: secretos y el resto del entorno viven en .env.example.
# Documentación y verificación: docs/configuracion-entornos.md.
# local enciende el escalón 6 para la cascada de la demo; producción lo deja fuera porque medir con
# tfidf-v3 da 0,875 de precisión de lo mostrado, por debajo de la compuerta 0,90 (docs/medicion-tfidf-v3.md).
CLASIFICADOR=tfidf
LEXICO=v2
AVISOS_ACTIVO=false
AVISOS_HORA=06:00
AVISOS_CUPO=3
VERA_PROVEEDOR=simulado
VERA_MODELO=
METRICAS_ACTIVO=false
ENRIQUECIMIENTO_INTERVAL=5m
