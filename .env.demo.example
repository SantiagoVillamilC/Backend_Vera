# Banderas del destino demo (infra/servidor/banderas.tsv).
# Solo banderas: secretos y el resto del entorno viven en .env.example.
# Documentación y verificación: docs/configuracion-entornos.md.
CLASIFICADOR=tfidf
LEXICO=v2
# demo es la única superficie donde el motor de avisos corre: emite a las 06:00 y una vez
# al arrancar, y como la bandeja de avisos de la app todavía no existe, el aviso se ve por
# la API. local y produccion lo dejan apagado (infra/servidor/banderas.tsv).
AVISOS_ACTIVO=true
AVISOS_HORA=06:00
AVISOS_CUPO=5
VERA_PROVEEDOR=simulado
VERA_MODELO=
METRICAS_ACTIVO=false
ENRIQUECIMIENTO_INTERVAL=5m
