# infra/modelos-runpod/.env.example
# Archivo de entorno de modelos-control (la unidad systemd lo lee con EnvironmentFile).
#
# Destino en la VM: /etc/vera-modelos/modelos-control.env, dueño root:root y modo 0600. Solo root lo lee.
# systemd lo abre como root ANTES de bajar privilegios, así que el usuario vera-modelos del servicio no
# necesita poder leerlo, y los secretos llegan al proceso como variables de entorno.
#
# NO copies este archivo a mano ni pegues secretos en él: infra/modelos-runpod/vm/generar-secretos.sh lo
# crea a partir de esta plantilla, genera los tokens y pide la clave de RunPod sin mostrarla.
# Los valores de ejemplo de abajo NO son secretos y no sirven para nada.
#
# Cómo se generan los secretos si prefieres hacerlo a mano (cada uno distinto, 64 caracteres hexadecimales):
#   openssl rand -hex 32
# Los tres tokens deben ser largos (32 caracteres o más) porque la API y los servidores lo exigen.

# ---------- Secretos ----------
# Clave de la API de RunPod de la cuenta de Vera. Se pega UNA vez en la terminal de la VM, nunca en el chat
# ni en el repositorio. Crea y termina pods, así que acota el saldo prepagado de esa cuenta.
RUNPOD_API_KEY=rpa_REEMPLAZAR_LA_CLAVE_DE_RUNPOD
# Token que protege el puerto de control (encender, apagar, estado). Lo usa quien pulsa el botón.
VERA_MODELOS_TOKEN_CONTROL=REEMPLAZAR_openssl_rand_hex_32
# Token de Kokoro (voz). Debe ser IGUAL a VERA_VOZ_TOKEN del archivo /opt/centinela/api/modelos.env.
VERA_MODELOS_TOKEN_VOZ=REEMPLAZAR_openssl_rand_hex_32
# Token de Whisper (transcripción). Debe ser IGUAL a VERA_STT_TOKEN de /opt/centinela/api/modelos.env.
VERA_MODELOS_TOKEN_STT=REEMPLAZAR_openssl_rand_hex_32

# ---------- Pod bajo demanda ----------
# GPUs aceptadas por orden de preferencia, separadas por coma, con el identificador de RunPod.
VERA_MODELOS_GPUS="NVIDIA RTX A5000"
# Nube de RunPod. Secure tiene IP pública estable y es la que midió el diseño.
VERA_MODELOS_NUBE=SECURE
# Tope de tarifa en USD por hora. Si el pod elegido cuesta más, modelos-control no lo crea.
VERA_MODELOS_TARIFA_MAX=0.35
# Minutos sin peticiones antes del apagado automático.
VERA_MODELOS_INACTIVIDAD_MIN=10
# Vida máxima de una sesión en horas, aunque haya tráfico. Corta el gasto de un pod olvidado.
VERA_MODELOS_SESION_MAX_H=4
# Nombre base de los pods. El guardián solo toca pods cuyo nombre empieza por este valor.
VERA_MODELOS_NOMBRE_POD=vera-modelos
# Plantilla de RunPod con CUDA y sshd. Es la de la tesis: no se ha vuelto a comprobar que exista.
VERA_MODELOS_PLANTILLA=runpod-torch-v280

# ---------- Qué corre en el pod (se lo entrega modelos-control a arrancar-modelos.sh) ----------
# Commit completo (40 caracteres) de Backend_Vera del que el pod baja los servidores de voz y de STT.
# Debe incluir la variante GPU de Kokoro (rama feat/kokoro-gpu ya fusionada).
VERA_MODELOS_CODIGO_SHA=0000000000000000000000000000000000000000
# Peticiones simultáneas de Ollama. 2 basta para una demo (5 GB de VRAM medidos en una 4090).
# Con 8 aguantó 8 usuarios, pero usa más VRAM.
VERA_MODELOS_OLLAMA_PARALELO=2
# Rutas EN LA VM del script de arranque y del de salud. modelos-control las envía al pod por ssh.
VERA_MODELOS_SCRIPT_ARRANQUE=/opt/vera-modelos/pod/arrancar-modelos.sh
VERA_MODELOS_SCRIPT_SALUD=/opt/vera-modelos/pod/salud-modelos.sh

# ---------- Túnel SSH de la VM hacia el pod ----------
# Llave privada del túnel. La crea generar-secretos.sh: dueño vera-modelos y modo 0600 (ssh la rechaza si
# otros usuarios pueden leerla).
VERA_MODELOS_SSH_CLAVE=/etc/vera-modelos/ssh/tunel_ed25519
# Parte pública de esa llave: modelos-control la entrega al pod al crearlo. No es secreta.
VERA_MODELOS_SSH_CLAVE_PUBLICA=/etc/vera-modelos/ssh/tunel_ed25519.pub
VERA_MODELOS_SSH_USUARIO=root

# ---------- Estado ----------
# Carpeta de estado del servicio (known_hosts del pod, bloqueo compartido, último pod, contadores).
# La crea systemd con StateDirectory=vera-modelos. Debe coincidir con esa carpeta.
VERA_MODELOS_DIR_ESTADO=/var/lib/vera-modelos

# ---------- Puertos ----------
# Dirección donde modelos-control ESCUCHA los tres puertos de los modelos. Tiene que ser la IP del gateway
# de la red docker "centinela" (así la alcanza el puente dentro del contenedor de la API) y NUNCA 0.0.0.0.
# Averigua el valor real con: infra/modelos-runpod/vm/puente-modelos.sh gateway
# El 172.18.0.1 de abajo es solo un ejemplo y puede ser otro.
VERA_MODELOS_ESCUCHA=172.18.0.1
VERA_MODELOS_PUERTO_OLLAMA=11434
VERA_MODELOS_PUERTO_VOZ=8766
VERA_MODELOS_PUERTO_STT=8767
# Dirección del puerto de control (botón). Solo loopback de la VM. Exponerlo por nginx es otra decisión.
VERA_MODELOS_CONTROL_ESCUCHA=127.0.0.1:8770

# ---------- Puente hacia la API (lo usa puente-modelos.sh, no modelos-control) ----------
# Imagen del contenedor puente. La misma de nginx que ya usa 30-nginx.sh, porque trae el módulo stream.
VERA_MODELOS_PUENTE_IMAGEN=nginx:1.27.5-alpine
# Red docker de la API.
VERA_MODELOS_RED_DOCKER=centinela
