# infra/modelos-runpod/.env.example
# Archivo de entorno de modelos-control (la unidad systemd lo lee con EnvironmentFile).
#
# Destino en la VM: /etc/vera-modelos/modelos-control.env, dueño root:root y modo 0600. Solo root lo lee.
# systemd lo abre como root ANTES de bajar privilegios, así que el usuario vera-modelos del servicio no
# necesita poder leerlo, y la clave de RunPod llega al proceso como variable de entorno.
#
# Los nombres son los que parsea cmd/modelos-control (internal/modelos/config/config.go): MODELOS_*, sin el
# prefijo VERA_. Todo lo que no aparezca aquí usa el valor por defecto del binario.
#
# NO copies este archivo a mano ni pegues secretos en él: infra/modelos-runpod/vm/generar-secretos.sh lo
# crea a partir de esta plantilla, genera los tokens y pide la clave de RunPod sin mostrarla.
# Los valores de ejemplo de abajo NO son secretos y no sirven para nada.
#
# Cómo se generan los secretos si prefieres hacerlo a mano (cada uno distinto, 64 caracteres hexadecimales):
#   openssl rand -hex 32
# Los tokens deben tener 32 caracteres o más: la API, los servidores y modelos-control lo exigen.

# ---------- Secreto en este archivo (root 0600) ----------
# Clave de la API de RunPod de la cuenta de Vera. Se pega UNA vez en la terminal de la VM, nunca en el chat
# ni en el repositorio. Crea y termina pods, así que acota el saldo prepagado de esa cuenta.
RUNPOD_API_KEY=rpa_REEMPLAZAR_LA_CLAVE_DE_RUNPOD
# Vacío a propósito: modelos-control toma la clave de RUNPOD_API_KEY (el entorno) en lugar de leer un archivo.
MODELOS_ARCHIVO_CLAVE_RUNPOD=

# ---------- Secretos en archivos propios (dueño vera-modelos, modo 0600) ----------
# Los crea generar-secretos.sh. modelos-control exige modo 0600 o más estricto y los lee con su propio usuario.
# VERA_STT_TOKEN y VERA_VOZ_TOKEN: los mismos dos valores que /opt/centinela/api/modelos.env (el de la API).
MODELOS_ARCHIVO_TOKENS=/etc/vera-modelos/tokens.env
# Token Bearer del puerto de control (encender, apagar, estado). Una sola línea.
MODELOS_ARCHIVO_TOKEN_CONTROL=/etc/vera-modelos/control.token
# Llave privada del túnel (ssh la rechaza si otros usuarios pueden leerla) y su parte pública, que
# modelos-control inyecta en el pod como PUBLIC_KEY. La pública no es secreta.
MODELOS_LLAVE_SSH=/etc/vera-modelos/ssh/tunel_ed25519
MODELOS_LLAVE_PUBLICA_SSH=/etc/vera-modelos/ssh/tunel_ed25519.pub

# ---------- Pod bajo demanda ----------
# GPUs aceptadas por orden de preferencia, separadas por coma, con el nombre de RunPod.
MODELOS_GPUS="NVIDIA RTX A5000"
# Imagen del pod: Ubuntu 24.04 trae Python 3.12 (los pines de requirements son de wheels cp312) y sshd.
MODELOS_IMAGEN=runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404
MODELOS_DISCO_GB=40
# Tope de tarifa en USD por hora. Si el pod elegido cuesta más, modelos-control no lo crea.
MODELOS_TARIFA_TOPE_USD_H=0.35
# Apagado automático tras este tiempo sin peticiones, y vida máxima de una sesión aunque haya tráfico.
MODELOS_INACTIVIDAD=10m
MODELOS_SESION_MAXIMA=4h

# ---------- Qué corre en el pod ----------
# OBLIGATORIO en la práctica. Commit completo (40 caracteres hexadecimales) de Backend_Vera del que el pod
# baja los servidores de voz y de STT. modelos-control acepta este valor vacío o cualquier texto corto, pero el
# script del pod exige 40 hexadecimales y sale con código 2 si no los recibe, después de haber creado (y
# cobrado) el pod. Debe incluir la variante GPU de Kokoro (rama feat/kokoro-gpu ya fusionada) y existir en
# GitHub. modelos-control lo exporta al script como REPO_SHA. Los ceros de abajo son un marcador: red-api.sh
# verificar lo marca como pendiente. Se fija con generar-secretos.sh --codigo-sha COMMIT.
MODELOS_REPO_SHA=0000000000000000000000000000000000000000
# Ruta EN LA VM del script de arranque. modelos-control lo copia por scp al pod (MODELOS_SCRIPT_REMOTO)
# y lo ejecuta con los tokens por stdin.
MODELOS_SCRIPT_ARRANQUE=/opt/vera-modelos/pod/arrancar-modelos.sh
MODELOS_SCRIPT_REMOTO=/tmp/vera-arranque.sh

# ---------- Estado ----------
# Carpeta de estado del servicio (known_hosts por pod, último pod, bloqueos). La crea systemd con
# StateDirectory=vera-modelos en las unidades. Debe coincidir con esa carpeta.
MODELOS_DIR_ESTADO=/var/lib/vera-modelos

# ---------- Puertos ----------
# El puerto de control (encender, apagar, estado) y los extremos del túnel SSH solo aceptan loopback.
MODELOS_PUERTO_CONTROL=127.0.0.1:8790
# Extremos locales del túnel SSH (por defecto 18434, 18766 y 18767). No hace falta definirlos.
#
# Los tres puertos de los modelos (los que alcanza la API) escuchan en la IP privada del gateway de la red
# docker "centinela", porque la API corre en un contenedor de esa red y su 127.0.0.1 no llega al host.
# <GATEWAY_DE_DOCKER> es un marcador explícito: la IP NO se inventa, se lee de la VM real con
#   docker network inspect centinela --format '{{(index .IPAM.Config 0).Gateway}}'
# y vm/red-api.sh instalar la escribe aquí y en el compose de la API. Mientras el marcador siga, modelos-control
# no arranca (configuración inválida, código 2), a propósito. modelos-control acepta loopback o una IPv4
# privada literal (10/8, 172.16/12, 192.168/16), nunca 0.0.0.0 ni nombres de host.
MODELOS_ESCUCHA_OLLAMA=<GATEWAY_DE_DOCKER>:11434
MODELOS_ESCUCHA_VOZ=<GATEWAY_DE_DOCKER>:8766
MODELOS_ESCUCHA_STT=<GATEWAY_DE_DOCKER>:8767
