# infra/modelos-runpod/systemd/vera-modelos-control.service
# Destino en la VM: /etc/systemd/system/vera-modelos-control.service (root:root 0644).
#
# modelos-control crea y apaga el pod de RunPod bajo demanda, abre el túnel SSH hacia él (con los binarios
# ssh y scp del sistema) y escucha en loopback los puertos de los modelos y el de control. El puente de
# puente-modelos.sh los lleva hasta 127.0.0.1 dentro del contenedor de la API.
#
# Secretos: la clave de RunPod llega por EnvironmentFile (root:root 0600). systemd lo abre como root antes de
# bajar privilegios, así que el usuario del servicio no necesita poder leerlo. Los tokens y la llave privada
# del túnel son archivos del usuario vera-modelos con modo 0600, porque modelos-control los lee por su ruta y
# ssh rechaza una llave que otros puedan leer. Alternativa más estricta para la llave: LoadCredential=, si
# modelos-control acepta una ruta de credencial.
#
# Egreso: NO se fija IPAddressDeny porque el servicio necesita llegar a la API de RunPod y al puerto SSH del
# pod, cuya IP cambia en cada pod. Se limita por familia de direcciones y por llamadas al sistema.
# Si el servicio no arranca, lo primero que hay que relajar de a uno es MemoryDenyWriteExecute y
# SystemCallFilter (el sandbox se verificó con systemd-analyze, no con el binario real).
[Unit]
Description=Vera modelos-control (pod de RunPod bajo demanda con túnel SSH)
Documentation=https://github.com/SantiagoVillamilC/Backend_Vera/blob/dev/docs/despliegue-modelos-runpod-vm.md
After=network-online.target docker.service
Wants=network-online.target docker.service
ConditionPathExists=/usr/local/bin/modelos-control
ConditionPathExists=/etc/vera-modelos/modelos-control.env
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=vera-modelos
Group=vera-modelos
EnvironmentFile=/etc/vera-modelos/modelos-control.env
ExecStart=/usr/local/bin/modelos-control servir
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=4096

# Límites de recursos
MemoryMax=256M
TasksMax=64
CPUQuota=50%

# Estado: known_hosts del pod, bloqueo compartido con el guardián y último pod. Lo crea systemd.
StateDirectory=vera-modelos
StateDirectoryMode=0700
WorkingDirectory=/var/lib/vera-modelos
ReadWritePaths=/var/lib/vera-modelos
UMask=0077

# Endurecimiento
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
