# Generado por red-api.sh instalar a partir de compose.z-modelos.yaml.plantilla. No editar a mano.
# Destino: /opt/centinela/infra-servidor/compose.z-modelos.yaml
#
# deploy-ci.sh y 60-api.sh unen todos los compose*.yaml del directorio, así que este archivo sobrevive a
# cada despliegue de la API. Empieza por "z" para que quede al final del glob y sus valores ganen sobre los
# de compose.api.yaml (environment se pisa clave por clave, env_file se suma).
# Para volver a simulado: red-api.sh desinstalar.
#
# La API corre en un contenedor de la red docker "centinela", así que su 127.0.0.1 no llega al host. Los
# modelos se alcanzan por la IP del gateway de esa red (<GATEWAY_DE_DOCKER>, leída con "docker network inspect"),
# donde escucha modelos-control. VERA_MODELOS_HOST_PERMITIDO autoriza a los clientes de la API a hablar con
# esa IP exacta y con ninguna otra IP privada.
services:
  api:
    # Solo VERA_STT_TOKEN y VERA_VOZ_TOKEN. La clave de RunPod NO entra en este contenedor.
    env_file:
      - @ARCHIVO_TOKENS_API@
    environment:
      VERA_PROVEEDOR: "local"
      VERA_MODELO: "gemma4-e4b-local"
      VERA_MODELOS_HOST_PERMITIDO: "<GATEWAY_DE_DOCKER>"
      VERA_OLLAMA_URL: "http://<GATEWAY_DE_DOCKER>:@PUERTO_OLLAMA@"
      VERA_STT_URL: "http://<GATEWAY_DE_DOCKER>:@PUERTO_STT@"
      VERA_VOZ_URL: "http://<GATEWAY_DE_DOCKER>:@PUERTO_VOZ@"
