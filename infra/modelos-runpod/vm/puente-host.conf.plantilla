# Generado por puente-modelos.sh instalar a partir de puente-host.conf.plantilla. No editar a mano.
#
# Corre en el contenedor "puente-host-modelos", en la red del HOST (network_mode: host). Solo existe porque
# modelos-control escucha únicamente en loopback (127.0.0.1 de la VM) y el puente de la API no puede llegar
# ahí. Este salto escucha en la IP del gateway de la red docker, que sí alcanzan los contenedores, y reenvía
# al loopback donde escucha modelos-control. Cada servidor liga una IP concreta, nunca 0.0.0.0.
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
  worker_connections 256;
}

stream {
  server {
    listen @GATEWAY@:@PUERTO_OLLAMA@;
    proxy_pass @ESCUCHA_MODELOS@:@PUERTO_OLLAMA@;
    proxy_connect_timeout 3s;
    proxy_timeout 600s;
  }
  server {
    listen @GATEWAY@:@PUERTO_STT@;
    proxy_pass @ESCUCHA_MODELOS@:@PUERTO_STT@;
    proxy_connect_timeout 3s;
    proxy_timeout 120s;
  }
  server {
    listen @GATEWAY@:@PUERTO_VOZ@;
    proxy_pass @ESCUCHA_MODELOS@:@PUERTO_VOZ@;
    proxy_connect_timeout 3s;
    proxy_timeout 120s;
  }
}
