aprovisionar.env

# Generados en tiempo de aprovisionamiento por infra/servidor/pasos/30-nginx.sh
# (SCRUM-32) y infra/servidor/pasos/40-postgres.sh (SCRUM-33) a partir de sus
# heredocs y de infra/servidor/dominio-fijado.sh. No son artefactos estáticos:
# la fuente de verdad es el paso que los escribe. El patrón cubre todos los
# fragmentos compose*.yaml (compose.yaml de nginx, compose.postgres.yaml de
# Postgres), uno por paso, fusionados en tiempo de "up -d" por
# asegurar_servicio_compose (ver lib/comun.sh).
compose*.yaml
nginx/
