# Token estático que comparten el simulador PSE y el núcleo. Debe tener 32 bytes o más.
CUSTODIO_TOKEN=cambia-esto-por-un-token-de-32-bytes

# Endpoint del núcleo que recibe la confirmación del depósito.
NUCLEO_CONFIRMACION_URL=http://api:8080/v1/depositos/confirmaciones

# Endpoint completo del simulador de custodia que recibe la notificación independiente.
SIMULADOR_CUSTODIA_URL=http://simulador-custodia:8099/notificaciones/depositos

# Puerto del host para el PSE. 8091 deja libre el 8090 del PSE anterior.
PSE_HOST_PORT=8091

# Etiqueta de las imágenes construidas localmente.
TAG=local

# Registro de imágenes. En el VPS apunta a GHCR para hacer docker compose pull.
REGISTRO=ghcr.io/santiagovillamilc/backend_vera
