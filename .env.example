# Plantilla sin secretos. Copiar a .env.local y completar sólo en la máquina local.
# Go lee variables de entorno; Docker puede cargar ese archivo con --env-file.
PORT=8080
DATABASE_URL=postgres://user:password@host:5432/dbname
APP_DATABASE_URL=postgres://rol_api:password@host:5432/dbname
JWT_SECRET=
CUSTODIO_TOKEN=
PSE_URL=https://pse.veraapp.tech
CUSTODIO_EXTRACTO_URL=http://127.0.0.1:8099/extracto
RIEL_SIMULADOR_URL=http://127.0.0.1:8098
DIRECTORIO_SIMULADOR_URL=http://127.0.0.1:8098
OCR_WORKER_URL=http://localhost:8000
OUTBOX_INTERVAL=5s
OUTBOX_BACKOFF_BASE=30s
OUTBOX_BACKOFF_FACTOR=2
OUTBOX_BACKOFF_MAX=30m
CONCILIATION_INTERVAL=60s
CONCILIATION_WINDOW=5m
TTL_INTENCION=60s
EXPIRACION_INTERVAL=60s
A6_POSICION_LIQUIDACION_CENTAVOS=0
A6_PREFONDEO_ACTIVO=false
CUSTODIO_ADDR=127.0.0.1
CUSTODIO_PERMITIR_EXPOSICION=false
CUSTODIO_PORT=8090
CUSTODIO_DB=./custodio.db
NUCLEO_CONFIRMACION_URL=http://127.0.0.1:8080/v1/depositos/confirmaciones
SIMULADOR_CUSTODIA_URL=http://127.0.0.1:8099/notificaciones/depositos
SIMULADOR_CUSTODIA_ADDR=127.0.0.1
SIMULADOR_CUSTODIA_PORT=8099
SIMULADOR_CUSTODIA_DB=./simulador-custodia.db
SIMULADOR_CUSTODIA_ORIGEN=simulador-custodia
SIMULADOR_CUSTODIA_PERMITIR_EXPOSICION=false
SIMULADOR_RIEL_ADDR=127.0.0.1
SIMULADOR_RIEL_PORT=8098
SIMULADOR_RIEL_DB=./simulador-riel.db
SIMULADOR_RIEL_ORIGEN=simulador-riel
SIMULADOR_RIEL_P_RECHAZO=0
SIMULADOR_RIEL_LATENCIA=0s
SIMULADOR_RIEL_LATENCIA_VARIACION=0s
SIMULADOR_RIEL_MODO_CAIDA=ninguna
SIMULADOR_RIEL_P_RESPUESTA_PERDIDA=0
SIMULADOR_RIEL_PERMITIR_EXPOSICION=false
SIMULADOR_RIEL_DIRECTORIO={}
SIMULADOR_CUSTODIA_P_RECHAZO=0
SIMULADOR_CUSTODIA_LATENCIA_MS=0
SIMULADOR_CUSTODIA_LATENCIA_VAR_MS=0
SIMULADOR_CUSTODIA_MODO_CAIDA=ninguno
SIMULADOR_CUSTODIA_P_RESPUESTA_PERDIDA=0
SIMULADOR_CUSTODIA_P_NOTIFICACION_PERDIDA=0
# Auth (fase 0): Redis fail closed y canal del OTP.
REDIS_URL=
JWT_ISSUER=centinela-auth
JWT_AUDIENCE=centinela-api
CONTADORES_PEPPER=
OTP_PEPPER=
OTP_CANAL=simulador
OTP_SIMULADOR_CODIGO_FIJO=123456
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
AUTH_RESET_TOKEN_TTL=1h
AUTH_ENFRIAMIENTO_CAMBIO_NUMERO=24h
DESTINATARIOS_LIMITE=20
DESTINATARIOS_VENTANA=1h
AUTH_CONTACTO_SOPORTE=
AUTH_VENTANA_PENDIENTE=24h
AUTH_LIMPIEZA_INTERVAL=15m
AUTH_OUTBOX_INTERVAL=10s
AUTH_OUTBOX_BACKOFF_BASE=5s
AUTH_OUTBOX_BACKOFF_FACTOR=2
AUTH_OUTBOX_BACKOFF_MAX=5m
AUTH_ARGON2_CONCURRENCIA=4
KYC_PROVEEDOR=simulador
KYC_SIMULADOR_RESULTADO=verificado

# Asistente Vera: simulado no requiere red ni credenciales.
VERA_PROVEEDOR=simulado
GEMINI_API_KEY=
# Opcional: habilita Catalina como selección inicial en el laboratorio real.
# No modifica la voz de producción ni activa Cartesia en la demo sin red.
CARTESIA_API_KEY=
# Para gemini: elegir un modelo Flash disponible en la cuenta (sin valor fijo).
VERA_MODELO=
VERA_TIMEOUT_LLAMADA=10s
VERA_TEMPERATURA=0.2
# Valores iniciales ajustables. Ventanas de reloj en hora de Colombia.
VERA_LIMITE_TEXTO_HORA=30
VERA_LIMITE_TEXTO_DIA=150
VERA_LIMITE_VOZ_HORA=10
VERA_TOKENS_DIARIOS=100000
# Reserva conservadora antes de cada llamada al proveedor, conciliada con su consumo.
VERA_TOKENS_RESERVA_LLAMADA=4096
# Umbral en pesos enteros; el backend convierte a centavos. Exige código si lo supera.
VERA_UMBRAL_CODIGO=500000
VERA_LLAVES_HABILITADAS=false
VERA_RETENCION_DIAS=30

# Inteligencia de consumo y métricas: valores opcionales, sin credenciales reales.
ENRIQUECIMIENTO_INTERVAL=5m
CLASIFICADOR=apagado
# Vacío conserva el léxico predeterminado de la aplicación.
LEXICO=
AVISOS_ACTIVO=false
AVISOS_HORA=06:00
METRICAS_ACTIVO=false
# Obligatorio y exclusivo cuando se habilitan métricas; completar sólo localmente.
METRICAS_TOKEN=
