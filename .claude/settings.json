{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/go-skill-router.sh",
            "timeout": 5,
            "statusMessage": "Go skill router"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/go-skill-router.sh",
            "timeout": 5,
            "statusMessage": "Go skill router"
          }
        ]
      }
    ]
  }
}
