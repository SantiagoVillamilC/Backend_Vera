}

Table finanzas.clasificacion_movimiento {
  componente_id uuid [pk, not null]
  propietario_id uuid [not null]
  categoria_id uuid
  naturaleza text [not null, default: `'pendiente'::text`]
  fuente text [not null]
  confianza_ppm integer
  modelo varchar(120)
  version_clasificador varchar(80)
  version integer [not null, default: `1`]
  actor_id uuid
  actualizada_en timestamptz [not null, default: `now()`]
  checks {
    `((naturaleza = 'pendiente'::text) = (categoria_id IS NULL))` [name: "clasificacion_movimiento_check"]
    `((fuente <> 'usuario'::text) OR (actor_id IS NOT NULL))` [name: "clasificacion_movimiento_check1"]
    `((fuente <> 'ia'::text) OR ((modelo IS NOT NULL) AND (version_clasificador IS NOT NULL) AND (confianza_ppm IS NOT NULL)))` [name: "clasificacion_movimiento_check2"]
    `((confianza_ppm >= 0) AND (confianza_ppm <= 1000000))` [name: "clasificacion_movimiento_confianza_ppm_check"]
    `(fuente = ANY (ARRAY['usuario'::text, 'regla'::text, 'ia'::text, 'sistema'::text]))` [name: "clasificacion_movimiento_fuente_check"]
    `(naturaleza = ANY (ARRAY['ingreso'::text, 'gasto'::text, 'traslado'::text, 'ajuste'::text, 'pendiente'::text]))` [name: "clasificacion_movimiento_naturaleza_check"]
    `(version > 0)` [name: "clasificacion_movimiento_version_check"]
  }
  Note: "PROPUESTA V2; NO IMPLEMENTADA. clasificacion_movimiento_check: CHECK (((naturaleza = 'pendiente'::text) = (categoria_id IS NULL)))\nclasificacion_movimiento_check1: CHECK (((fuente <> 'usuario'::text) OR (actor_id IS NOT NULL)))\nclasificacion_movimiento_check2: CHECK (((fuente <> 'ia'::text) OR ((modelo IS NOT NULL) AND (version_clasificador IS NOT NULL) AND (confianza_ppm IS NOT NULL))))\nclasificacion_movimiento_confianza_ppm_check: CHECK (((confianza_ppm >= 0) AND (confianza_ppm <= 1000000)))\nclasificacion_movimiento_fuente_check: CHECK ((fuente = ANY (ARRAY['usuario'::text, 'regla'::text, 'ia'::text, 'sistema'::text])))\nclasificacion_movimiento_naturaleza_check: CHECK ((naturaleza = ANY (ARRAY['ingreso'::text, 'gasto'::text, 'traslado'::text, 'ajuste'::text, 'pendiente'::text])))\nclasificacion_movimiento_version_check: CHECK ((version > 0))\nINDICES FISICOS:\nCREATE INDEX clasificacion_categoria_idx ON finanzas.clasificacion_movimiento USING btree (propietario_id, categoria_id, componente_id)\nCREATE UNIQUE INDEX clasificacion_movimiento_pkey ON finanzas.clasificacion_movimiento USING btree (componente_id)"
}

