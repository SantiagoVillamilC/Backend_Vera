  Note: "ACTUAL. \nINDICES FISICOS:\nCREATE INDEX codigos_respaldo_pendientes ON auth.codigos_respaldo USING btree (credencial_id) WHERE (usado_en IS NULL)\nCREATE UNIQUE INDEX codigos_respaldo_pkey ON auth.codigos_respaldo USING btree (id)"
}

Table auth.consentimientos {
  id uuid [pk, not null]
  parte_id uuid [not null]
  tipo text [not null]
  version_texto text [not null]
  texto text [not null]
  aceptado boolean [not null]
  accion text [not null]
  actor uuid
  origen text [not null]
  user_agent text [not null, default: `''::text`]
  metodo text [not null]
  ocurrido_en timestamptz [not null, default: `now()`]
  orden bigint [not null, increment]
  checks {
    `(tipo = ANY (ARRAY['tratamiento_datos'::text, 'whatsapp_optin'::text, 'biometricos'::text, 'asistente_ia'::text]))` [name: "consentimientos_tipo_check"]
  }
  Note: "ACTUAL. consentimientos_tipo_check: CHECK ((tipo = ANY (ARRAY['tratamiento_datos'::text, 'whatsapp_optin'::text, 'biometricos'::text, 'asistente_ia'::text])))\nINDICES FISICOS:\nCREATE INDEX consentimientos_asistente_ultimo ON auth.consentimientos USING btree (parte_id, orden DESC) WHERE (tipo = 'asistente_ia'::text)\nCREATE INDEX consentimientos_parte ON auth.consentimientos USING btree (parte_id, tipo, ocurrido_en)\nCREATE UNIQUE INDEX consentimientos_pkey ON auth.consentimientos USING btree (id)"
}

Table auth.credenciales {
  id uuid [pk, not null]
  parte_id uuid [not null]
  correo text [not null]
  celular text [not null]
  celular_verificado_en timestamptz
  correo_verificado_en timestamptz
  celular_cambiado_en timestamptz
  valor_derivado text
  estado text [not null]
  creada_en timestamptz [not null, default: `now()`]
  actualizada_en timestamptz [not null, default: `now()`]
  indexes {
    (parte_id) [unique, name: "credenciales_parte_id_uk"]
  }
  checks {
    `(estado = ANY (ARRAY['pendiente_verificacion'::text, 'activo'::text, 'suspendido'::text, 'cerrado'::text, 'sin_login'::text]))` [name: "credenciales_estado_check"]
    `((estado = 'sin_login'::text) OR (valor_derivado IS NOT NULL))` [name: "credenciales_valor_derivado_requerido"]
  }
  Note: "ACTUAL. credenciales_estado_check: CHECK ((estado = ANY (ARRAY['pendiente_verificacion'::text, 'activo'::text, 'suspendido'::text, 'cerrado'::text, 'sin_login'::text])))\ncredenciales_valor_derivado_requerido: CHECK (((estado = 'sin_login'::text) OR (valor_derivado IS NOT NULL)))\nINDICES FISICOS:\nCREATE UNIQUE INDEX credenciales_celular_uk ON auth.credenciales USING btree (celular) WHERE (estado <> 'cerrado'::text)\nCREATE UNIQUE INDEX credenciales_correo_uk ON auth.credenciales USING btree (correo) WHERE (estado <> 'cerrado'::text)\nCREATE UNIQUE INDEX credenciales_parte_id_uk ON auth.credenciales USING btree (parte_id)\nCREATE UNIQUE INDEX credenciales_pkey ON auth.credenciales USING btree (id)"
}

Table auth.desafios {
  id uuid [pk, not null]
  parte_id uuid
  credencial_id uuid
  proposito text [not null]
