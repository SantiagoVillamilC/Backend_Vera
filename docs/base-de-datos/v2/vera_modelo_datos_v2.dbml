Project vera_modelo {
  database_type: 'PostgreSQL'
}

Table asistente.accion_pendiente {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  usuario_id uuid [not null]
  conversacion_id uuid [not null]
  tipo text [not null]
  destino text [not null]
  tipo_llave text
  nombre_mostrado text [not null]
  celular_enmascarado text
  entidad_destino text
  monto bigint [not null, note: "Centavos COP enteros. Nunca pesos enteros ni punto flotante."]
  moneda text [not null, default: `'COP'::text`]
  requiere_codigo boolean [not null]
  desafio_id uuid
  estado text [not null, default: `'pendiente'::text`]
  transferencia_id uuid
  codigo_error text
  creada_en timestamptz [not null, default: `now()`]
  expira_en timestamptz [not null, default: `(now() + '00:05:00'::interval)`]
  resuelta_en timestamptz
  usuario_financiero_id text [not null]
  indexes {
    (conversacion_id, id) [unique, name: "accion_conversacion_id_uk"]
  }
  checks {
    `((estado <> 'confirmada'::text) OR (NOT requiere_codigo) OR (desafio_id IS NOT NULL))` [name: "accion_confirmacion_codigo"]
    `((desafio_id IS NULL) OR requiere_codigo)` [name: "accion_desafio"]
    `(((tipo = 'transferencia_interna'::text) AND (tipo_llave IS NULL)) OR ((tipo = 'transferencia_llave'::text) AND (tipo_llave IS NOT NULL)))` [name: "accion_destino_tipo"]
    `(((estado = 'fallida'::text) AND (codigo_error IS NOT NULL) AND (length(btrim(codigo_error)) > 0)) OR ((estado <> 'fallida'::text) AND (codigo_error IS NULL)))` [name: "accion_error"]
    `(length(btrim(usuario_financiero_id)) > 0)` [name: "accion_origen_presente"]
    `(length(btrim(destino)) > 0)` [name: "accion_pendiente_destino_check"]
    `(estado = ANY (ARRAY['pendiente'::text, 'confirmada'::text, 'cancelada'::text, 'vencida'::text, 'fallida'::text]))` [name: "accion_pendiente_estado_check"]
    `(moneda = 'COP'::text)` [name: "accion_pendiente_moneda_check"]
    `(monto > 0)` [name: "accion_pendiente_monto_check"]
    `(length(btrim(nombre_mostrado)) > 0)` [name: "accion_pendiente_nombre_mostrado_check"]
    `(tipo = ANY (ARRAY['transferencia_interna'::text, 'transferencia_llave'::text]))` [name: "accion_pendiente_tipo_check"]
    `(tipo_llave = ANY (ARRAY['documento'::text, 'celular'::text, 'correo'::text, 'alfanumerico'::text, 'comercio'::text]))` [name: "accion_pendiente_tipo_llave_check"]
    `(((estado = 'pendiente'::text) AND (resuelta_en IS NULL)) OR ((estado <> 'pendiente'::text) AND (resuelta_en IS NOT NULL) AND (resuelta_en >= creada_en)))` [name: "accion_resolucion"]
    `((estado = 'confirmada'::text) = (transferencia_id IS NOT NULL))` [name: "accion_transferencia"]
    `(expira_en = (creada_en + '00:05:00'::interval))` [name: "accion_vigencia"]
  }
  Note: "ACTUAL. accion_confirmacion_codigo: CHECK (((estado <> 'confirmada'::text) OR (NOT requiere_codigo) OR (desafio_id IS NOT NULL)))\naccion_desafio: CHECK (((desafio_id IS NULL) OR requiere_codigo))\naccion_destino_tipo: CHECK ((((tipo = 'transferencia_interna'::text) AND (tipo_llave IS NULL)) OR ((tipo = 'transferencia_llave'::text) AND (tipo_llave IS NOT NULL))))\naccion_error: CHECK ((((estado = 'fallida'::text) AND (codigo_error IS NOT NULL) AND (length(btrim(codigo_error)) > 0)) OR ((estado <> 'fallida'::text) AND (codigo_error IS NULL))))\naccion_origen_presente: CHECK ((length(btrim(usuario_financiero_id)) > 0))\naccion_pendiente_destino_check: CHECK ((length(btrim(destino)) > 0))\naccion_pendiente_estado_check: CHECK ((estado = ANY (ARRAY['pendiente'::text, 'confirmada'::text, 'cancelada'::text, 'vencida'::text, 'fallida'::text])))\naccion_pendiente_moneda_check: CHECK ((moneda = 'COP'::text))\naccion_pendiente_monto_check: CHECK ((monto > 0))\naccion_pendiente_nombre_mostrado_check: CHECK ((length(btrim(nombre_mostrado)) > 0))\naccion_pendiente_tipo_check: CHECK ((tipo = ANY (ARRAY['transferencia_interna'::text, 'transferencia_llave'::text])))\naccion_pendiente_tipo_llave_check: CHECK ((tipo_llave = ANY (ARRAY['documento'::text, 'celular'::text, 'correo'::text, 'alfanumerico'::text, 'comercio'::text])))\naccion_resolucion: CHECK ((((estado = 'pendiente'::text) AND (resuelta_en IS NULL)) OR ((estado <> 'pendiente'::text) AND (resuelta_en IS NOT NULL) AND (resuelta_en >= creada_en))))\naccion_transferencia: CHECK (((estado = 'confirmada'::text) = (transferencia_id IS NOT NULL)))\naccion_vigencia: CHECK ((expira_en = (creada_en + '00:05:00'::interval)))\nINDICES FISICOS:\nCREATE UNIQUE INDEX accion_conversacion_id_uk ON asistente.accion_pendiente USING btree (conversacion_id, id)\nCREATE INDEX accion_expiracion_idx ON asistente.accion_pendiente USING btree (expira_en, id) WHERE (estado = 'pendiente'::text)\nCREATE UNIQUE INDEX accion_pendiente_conversacion_uk ON asistente.accion_pendiente USING btree (conversacion_id) WHERE (estado = 'pendiente'::text)\nCREATE UNIQUE INDEX accion_pendiente_pkey ON asistente.accion_pendiente USING btree (id)\nCREATE UNIQUE INDEX accion_transferencia_uk ON asistente.accion_pendiente USING btree (transferencia_id) WHERE (transferencia_id IS NOT NULL)\nCREATE INDEX accion_usuario_idx ON asistente.accion_pendiente USING btree (usuario_id, creada_en DESC, id DESC)"
}

Table asistente.conversacion {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  usuario_id uuid [not null]
  titulo varchar(120)
  estado text [not null, default: `'activo'::text`]
  cantidad_mensajes integer [not null, default: `0`]
  creada_en timestamptz [not null, default: `clock_timestamp()`]
  ultimo_mensaje_en timestamptz [not null, default: `clock_timestamp()`]
  ciclo_token uuid
  ciclo_expira_en timestamptz
  usuario_financiero_id text [not null]
  indexes {
    (id, usuario_id) [unique, name: "conversacion_propietario_uk"]
  }
  checks {
    `(cantidad_mensajes >= 0)` [name: "conversacion_cantidad_mensajes_check"]
    `((ciclo_token IS NULL) = (ciclo_expira_en IS NULL))` [name: "conversacion_ciclo_completo"]
    `(estado = ANY (ARRAY['activo'::text, 'archivado'::text]))` [name: "conversacion_estado_check"]
    `(length(btrim(usuario_financiero_id)) > 0)` [name: "conversacion_origen_presente"]
  }
  Note: "ACTUAL. conversacion_cantidad_mensajes_check: CHECK ((cantidad_mensajes >= 0))\nconversacion_ciclo_completo: CHECK (((ciclo_token IS NULL) = (ciclo_expira_en IS NULL)))\nconversacion_estado_check: CHECK ((estado = ANY (ARRAY['activo'::text, 'archivado'::text])))\nconversacion_origen_presente: CHECK ((length(btrim(usuario_financiero_id)) > 0))\nINDICES FISICOS:\nCREATE UNIQUE INDEX conversacion_pkey ON asistente.conversacion USING btree (id)\nCREATE UNIQUE INDEX conversacion_propietario_uk ON asistente.conversacion USING btree (id, usuario_id)\nCREATE INDEX conversacion_reciente_idx ON asistente.conversacion USING btree (usuario_id, ultimo_mensaje_en DESC, id DESC)\nCREATE INDEX conversacion_retencion_idx ON asistente.conversacion USING btree (ultimo_mensaje_en)"
}

Table asistente.ejecucion_proveedor {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  turno_id uuid [not null]
  usuario_id uuid [not null]
  usuario_financiero_id text [not null]
  conversacion_id uuid
  mensaje_id uuid
  operacion text [not null]
  proveedor varchar(80) [not null]
  modelo varchar(120) [not null]
  version_instrucciones varchar(80)
  intento smallint [not null]
  resultado text [not null]
  codigo_proveedor varchar(80)
  reintentar_en timestamptz
  tokens_entrada bigint
  tokens_salida bigint
  latencia_ms bigint [not null]
  primer_audio_ms bigint
  request_id varchar(128) [not null]
  iniciada_en timestamptz [not null]
  indexes {
    (turno_id, operacion, intento) [unique, name: "ejecucion_proveedor_turno_id_operacion_intento_key"]
  }
  checks {
    `((primer_audio_ms >= 0) AND (primer_audio_ms <= latencia_ms))` [name: "ejecucion_proveedor_check"]
    `(intento > 0)` [name: "ejecucion_proveedor_intento_check"]
    `(latencia_ms >= 0)` [name: "ejecucion_proveedor_latencia_ms_check"]
    `(operacion = ANY (ARRAY['chat'::text, 'transcripcion'::text, 'sintesis'::text]))` [name: "ejecucion_proveedor_operacion_check"]
    `(resultado = ANY (ARRAY['ok'::text, 'cuota'::text, 'seguridad'::text, 'timeout'::text, 'cancelada'::text, 'error'::text]))` [name: "ejecucion_proveedor_resultado_check"]
    `(tokens_entrada >= 0)` [name: "ejecucion_proveedor_tokens_entrada_check"]
    `(tokens_salida >= 0)` [name: "ejecucion_proveedor_tokens_salida_check"]
  }
  Note: "PROPUESTA V2; NO IMPLEMENTADA. ejecucion_proveedor_check: CHECK (((primer_audio_ms >= 0) AND (primer_audio_ms <= latencia_ms)))\nejecucion_proveedor_intento_check: CHECK ((intento > 0))\nejecucion_proveedor_latencia_ms_check: CHECK ((latencia_ms >= 0))\nejecucion_proveedor_operacion_check: CHECK ((operacion = ANY (ARRAY['chat'::text, 'transcripcion'::text, 'sintesis'::text])))\nejecucion_proveedor_resultado_check: CHECK ((resultado = ANY (ARRAY['ok'::text, 'cuota'::text, 'seguridad'::text, 'timeout'::text, 'cancelada'::text, 'error'::text])))\nejecucion_proveedor_tokens_entrada_check: CHECK ((tokens_entrada >= 0))\nejecucion_proveedor_tokens_salida_check: CHECK ((tokens_salida >= 0))\nINDICES FISICOS:\nCREATE INDEX ejecucion_proveedor_fecha_idx ON asistente.ejecucion_proveedor USING btree (iniciada_en)\nCREATE UNIQUE INDEX ejecucion_proveedor_pkey ON asistente.ejecucion_proveedor USING btree (id)\nCREATE UNIQUE INDEX ejecucion_proveedor_turno_id_operacion_intento_key ON asistente.ejecucion_proveedor USING btree (turno_id, operacion, intento)\nCREATE INDEX ejecucion_proveedor_turno_idx ON asistente.ejecucion_proveedor USING btree (usuario_id, turno_id)"
}

Table asistente.llamada_funcion {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  llamada_id uuid [not null]
  fase text [not null]
  usuario_id uuid [not null]
  conversacion_id uuid [not null]
  mensaje_id uuid [not null]
  funcion text [not null]
  argumentos_saneados jsonb [not null]
  resultado varchar(40) [not null]
  duracion_ms bigint [not null]
  request_id varchar(128) [not null]
  version_instrucciones varchar(80) [not null]
  ocurrida_en timestamptz [not null, default: `clock_timestamp()`]
  indexes {
    (llamada_id, fase) [unique, name: "llamada_fase_uk"]
  }
  checks {
    `((jsonb_typeof(argumentos_saneados) = 'object'::text) AND (octet_length((argumentos_saneados)::text) <= 2048))` [name: "llamada_funcion_argumentos_saneados_check"]
    `(duracion_ms >= 0)` [name: "llamada_funcion_duracion_ms_check"]
    `(fase = ANY (ARRAY['inicio'::text, 'fin'::text]))` [name: "llamada_funcion_fase_check"]
    `(funcion = ANY (ARRAY['consultar_saldo'::text, 'consultar_limites'::text, 'listar_movimientos'::text, 'resumir_movimientos'::text, 'buscar_destinatario'::text, 'consultar_transferencia'::text, 'preparar_transferencia'::text, 'desconocida'::text]))` [name: "llamada_funcion_funcion_check"]
    `((resultado)::text ~ '^[A-Za-z][A-Za-z0-9]{0,39}$'::text)` [name: "llamada_funcion_resultado_check"]
    `((fase <> 'inicio'::text) OR (((resultado)::text = 'InProgress'::text) AND (duracion_ms = 0)))` [name: "llamada_inicio"]
  }
  Note: "ACTUAL. llamada_funcion_argumentos_saneados_check: CHECK (((jsonb_typeof(argumentos_saneados) = 'object'::text) AND (octet_length((argumentos_saneados)::text) <= 2048)))\nllamada_funcion_duracion_ms_check: CHECK ((duracion_ms >= 0))\nllamada_funcion_fase_check: CHECK ((fase = ANY (ARRAY['inicio'::text, 'fin'::text])))\nllamada_funcion_funcion_check: CHECK ((funcion = ANY (ARRAY['consultar_saldo'::text, 'consultar_limites'::text, 'listar_movimientos'::text, 'resumir_movimientos'::text, 'buscar_destinatario'::text, 'consultar_transferencia'::text, 'preparar_transferencia'::text, 'desconocida'::text])))\nllamada_funcion_resultado_check: CHECK (((resultado)::text ~ '^[A-Za-z][A-Za-z0-9]{0,39}$'::text))\nllamada_inicio: CHECK (((fase <> 'inicio'::text) OR (((resultado)::text = 'InProgress'::text) AND (duracion_ms = 0))))\nINDICES FISICOS:\nCREATE UNIQUE INDEX llamada_fase_uk ON asistente.llamada_funcion USING btree (llamada_id, fase)\nCREATE INDEX llamada_fecha_idx ON asistente.llamada_funcion USING btree (ocurrida_en, id)\nCREATE UNIQUE INDEX llamada_funcion_pkey ON asistente.llamada_funcion USING btree (id)\nCREATE INDEX llamada_mensaje_idx ON asistente.llamada_funcion USING btree (conversacion_id, mensaje_id, ocurrida_en, id)"
}

Table asistente.mensaje {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  conversacion_id uuid [not null]
  numero_orden integer [not null]
  rol text [not null]
  canal text [not null]
  contenido text [not null]
  nombre_modelo varchar(120)
  version_instrucciones text
  tokens_entrada integer
  tokens_salida integer
  latencia_ms integer
  metadatos jsonb [not null, default: `'{}'::jsonb`]
  respuesta_a uuid
  creada_en timestamptz [not null, default: `clock_timestamp()`]
  accion_id uuid
  indexes {
    (conversacion_id, id) [unique, name: "mensaje_conversacion_id_uk"]
    (conversacion_id, numero_orden) [unique, name: "mensaje_orden_uk"]
  }
  checks {
    `((accion_id IS NULL) OR ((rol = 'asistente'::text) AND (respuesta_a IS NOT NULL)))` [name: "mensaje_accion_final"]
    `(canal = ANY (ARRAY['texto'::text, 'voz'::text]))` [name: "mensaje_canal_check"]
    `(length(btrim(contenido)) > 0)` [name: "mensaje_contenido_check"]
    `(latencia_ms >= 0)` [name: "mensaje_latencia_ms_check"]
    `(jsonb_typeof(metadatos) = 'object'::text)` [name: "mensaje_metadatos_check"]
    `(numero_orden > 0)` [name: "mensaje_numero_orden_check"]
    `((respuesta_a IS NULL) OR (rol = 'asistente'::text))` [name: "mensaje_respuesta_rol"]
    `(rol = ANY (ARRAY['usuario'::text, 'asistente'::text, 'herramienta'::text]))` [name: "mensaje_rol_check"]
    `(tokens_entrada >= 0)` [name: "mensaje_tokens_entrada_check"]
    `(tokens_salida >= 0)` [name: "mensaje_tokens_salida_check"]
  }
  Note: "ACTUAL. mensaje_accion_final: CHECK (((accion_id IS NULL) OR ((rol = 'asistente'::text) AND (respuesta_a IS NOT NULL))))\nmensaje_canal_check: CHECK ((canal = ANY (ARRAY['texto'::text, 'voz'::text])))\nmensaje_contenido_check: CHECK ((length(btrim(contenido)) > 0))\nmensaje_latencia_ms_check: CHECK ((latencia_ms >= 0))\nmensaje_metadatos_check: CHECK ((jsonb_typeof(metadatos) = 'object'::text))\nmensaje_numero_orden_check: CHECK ((numero_orden > 0))\nmensaje_respuesta_rol: CHECK (((respuesta_a IS NULL) OR (rol = 'asistente'::text)))\nmensaje_rol_check: CHECK ((rol = ANY (ARRAY['usuario'::text, 'asistente'::text, 'herramienta'::text])))\nmensaje_tokens_entrada_check: CHECK ((tokens_entrada >= 0))\nmensaje_tokens_salida_check: CHECK ((tokens_salida >= 0))\nINDICES FISICOS:\nCREATE UNIQUE INDEX mensaje_conversacion_id_uk ON asistente.mensaje USING btree (conversacion_id, id)\nCREATE UNIQUE INDEX mensaje_orden_uk ON asistente.mensaje USING btree (conversacion_id, numero_orden)\nCREATE UNIQUE INDEX mensaje_pkey ON asistente.mensaje USING btree (id)\nCREATE INDEX mensaje_respuesta_idx ON asistente.mensaje USING btree (respuesta_a) WHERE (respuesta_a IS NOT NULL)"
}

Table asistente.solicitud_texto {
  usuario_id uuid [not null]
  clave uuid [not null]
  conversacion_id uuid [not null]
  mensaje_id uuid [not null]
  huella bytea [not null]
  creada_en timestamptz [not null, default: `clock_timestamp()`]
  indexes {
    (usuario_id, clave) [pk]
  }
  checks {
    `(octet_length(huella) = 32)` [name: "solicitud_texto_huella_check"]
  }
  Note: "ACTUAL. solicitud_texto_huella_check: CHECK ((octet_length(huella) = 32))\nINDICES FISICOS:\nCREATE UNIQUE INDEX solicitud_texto_pkey ON asistente.solicitud_texto USING btree (usuario_id, clave)"
}

