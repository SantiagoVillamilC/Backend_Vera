  codigo_hmac bytea [not null]
  intentos integer [not null, default: `0`]
  reenvios integer [not null, default: `0`]
  estado text [not null]
  creado_en timestamptz [not null]
  expira_en timestamptz [not null]
  ultimo_envio_en timestamptz [not null]
  contexto_solicitado text
  celular_nuevo text
  desafio_padre_id uuid
  checks {
    `(estado = ANY (ARRAY['pendiente'::text, 'verificado'::text, 'invalidado'::text, 'expirado'::text]))` [name: "desafios_estado_check"]
    `(proposito = ANY (ARRAY['registro'::text, 'login'::text, 'recuperacion'::text, 'cambio_numero'::text, 'cambio_numero_viejo'::text, 'confirmacion_transferencia'::text]))` [name: "desafios_proposito_check"]
  }
  Note: "ACTUAL. desafios_estado_check: CHECK ((estado = ANY (ARRAY['pendiente'::text, 'verificado'::text, 'invalidado'::text, 'expirado'::text])))\ndesafios_proposito_check: CHECK ((proposito = ANY (ARRAY['registro'::text, 'login'::text, 'recuperacion'::text, 'cambio_numero'::text, 'cambio_numero_viejo'::text, 'confirmacion_transferencia'::text])))\nINDICES FISICOS:\nCREATE INDEX desafios_pendientes ON auth.desafios USING btree (expira_en) WHERE (estado = 'pendiente'::text)\nCREATE UNIQUE INDEX desafios_pkey ON auth.desafios USING btree (id)"
}

Table auth.empresas {
  parte_id uuid [pk, not null]
  nit text [not null]
  razon_social text [not null]
  indexes {
