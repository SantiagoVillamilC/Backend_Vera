  }
  Note: "ACTUAL. consentimientos_tipo_check: CHECK ((tipo = ANY (ARRAY['tratamiento_datos'::text, 'whatsapp_optin'::text, 'biometricos'::text, 'asistente_ia'::text])))\nINDICES FISICOS:\nCREATE INDEX consentimientos_asistente_ultimo ON auth.consentimientos USING btree (parte_id, orden DESC) WHERE (tipo = 'asistente_ia'::text)\nCREATE INDEX consentimientos_parte ON auth.consentimientos USING btree (parte_id, tipo, ocurrido_en)\nCREATE UNIQUE INDEX consentimientos_pkey ON auth.consentimientos USING btree (id)"
}

Table auth.credenciales {
  id uuid [pk, not null]
  parte_id uuid [not null]
  correo text [not null]
  celular text [not null]
  celular_verificado_en timestamptz
  correo_verificado_en timestamptz
