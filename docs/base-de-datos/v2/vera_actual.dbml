  id bigint [pk, not null, increment]
  tipo text [not null]
  payload jsonb [not null]
  disponible_en timestamptz [not null, default: `now()`]
  intentos integer [not null, default: `0`]
  ultimo_error text
  despachado_en timestamptz
  Note: "ACTUAL. \nINDICES FISICOS:\nCREATE INDEX outbox_despacho_por_transferencia ON nucleo.outbox USING btree (((payload ->> 'transferencia_id'::text))) WHERE ((tipo = 'despacho_transferencia'::text) AND (despachado_en IS NULL))\nCREATE INDEX outbox_pendientes ON nucleo.outbox USING btree (disponible_en) WHERE (despachado_en IS NULL)\nCREATE UNIQUE INDEX outbox_pkey ON nucleo.outbox USING btree (id)"
}

Table nucleo.posting {
  id bigint [pk, not null, increment]
  entry_id bigint [not null]
  cuenta_id text [not null]
  monto bigint [not null, note: "Centavos COP enteros. Nunca pesos enteros ni punto flotante."]
  moneda char(3) [not null]
  ocurrido_en timestamptz [not null]
  checks {
    `(monto <> 0)` [name: "posting_monto_check"]
  }
  Note: "ACTUAL. posting_monto_check: CHECK ((monto <> 0))\nINDICES FISICOS:\nCREATE INDEX posting_cuenta_fecha_idx ON nucleo.posting USING btree (cuenta_id, ocurrido_en DESC, entry_id DESC) INCLUDE (moneda)\nCREATE UNIQUE INDEX posting_pkey ON nucleo.posting USING btree (id)\nCREATE INDEX posting_por_asiento ON nucleo.posting USING btree (entry_id)\nCREATE INDEX posting_por_cuenta ON nucleo.posting USING btree (cuenta_id, id)"
}

Table nucleo.regla_limite {
  id text [pk, not null]
  nivel_kyc text [not null]
  ventana text [not null]
  tope_uvt_centesimas bigint [not null]
  conteo_maximo integer
  vigente_desde date [not null]
  vigente_hasta date
  fuente text [not null]
  tipo text [not null, default: `'rechaza'::text`]
  tarifa_ppm bigint [not null, default: `0`]
  checks {
    `(((tipo = 'rechaza'::text) AND (tarifa_ppm = 0)) OR ((tipo = 'grava'::text) AND (tarifa_ppm > 0)))` [name: "regla_limite_tarifa_coherente"]
    `(tipo = ANY (ARRAY['rechaza'::text, 'grava'::text]))` [name: "regla_limite_tipo_valido"]
    `(tope_uvt_centesimas > 0)` [name: "regla_limite_tope_uvt_centesimas_check"]
    `(ventana = ANY (ARRAY['operacion'::text, 'diaria'::text, 'mensual'::text]))` [name: "regla_limite_ventana_check"]
    `((vigente_hasta IS NULL) OR (vigente_hasta > vigente_desde))` [name: "regla_limite_vigencia_coherente"]
  }
  Note: "ACTUAL. regla_limite_tarifa_coherente: CHECK ((((tipo = 'rechaza'::text) AND (tarifa_ppm = 0)) OR ((tipo = 'grava'::text) AND (tarifa_ppm > 0))))\nregla_limite_tipo_valido: CHECK ((tipo = ANY (ARRAY['rechaza'::text, 'grava'::text])))\nregla_limite_tope_uvt_centesimas_check: CHECK ((tope_uvt_centesimas > 0))\nregla_limite_ventana_check: CHECK ((ventana = ANY (ARRAY['operacion'::text, 'diaria'::text, 'mensual'::text])))\nregla_limite_vigencia_coherente: CHECK (((vigente_hasta IS NULL) OR (vigente_hasta > vigente_desde)))\nINDICES FISICOS:\nCREATE UNIQUE INDEX regla_limite_pkey ON nucleo.regla_limite USING btree (id)"
}

Table nucleo.transferencia {
  id uuid [pk, not null]
  usuario_id text [not null]
  cuenta_origen text [not null]
  llave_destino text [not null]
  monto bigint [not null, note: "Centavos COP enteros. Nunca pesos enteros ni punto flotante."]
  moneda char(3) [not null, default: `'COP'::bpchar`]
  idempotency_key text [not null]
  estado text [not null]
  creada_en timestamptz [not null, default: `now()`]
  actualizada_en timestamptz [not null, default: `now()`]
  indexes {
    (usuario_id, idempotency_key) [unique, name: "transferencia_idempotencia_unica"]
  }
  checks {
    `(estado = ANY (ARRAY['creada'::text, 'reservada'::text, 'despachada'::text, 'confirmada'::text, 'fallida'::text, 'indeterminada'::text, 'compensada'::text]))` [name: "transferencia_estado_check"]
    `(monto > 0)` [name: "transferencia_monto_check"]
  }
  Note: "ACTUAL. transferencia_estado_check: CHECK ((estado = ANY (ARRAY['creada'::text, 'reservada'::text, 'despachada'::text, 'confirmada'::text, 'fallida'::text, 'indeterminada'::text, 'compensada'::text])))\ntransferencia_monto_check: CHECK ((monto > 0))\nINDICES FISICOS:\nCREATE INDEX transferencia_activas_por_actualizada ON nucleo.transferencia USING btree (actualizada_en) WHERE (estado = ANY (ARRAY['despachada'::text, 'indeterminada'::text]))\nCREATE INDEX transferencia_debito_del_mes ON nucleo.transferencia USING btree (usuario_id, creada_en) INCLUDE (monto, estado)\nCREATE UNIQUE INDEX transferencia_idempotencia_unica ON nucleo.transferencia USING btree (usuario_id, idempotency_key)\nCREATE UNIQUE INDEX transferencia_pkey ON nucleo.transferencia USING btree (id)"
}

Table nucleo.valor_uvt {
  anio integer [pk, not null]
  valor_centavos bigint [not null, note: "Centavos COP enteros. Nunca pesos enteros ni punto flotante."]
  fuente text [not null]
  checks {
    `(valor_centavos > 0)` [name: "valor_uvt_valor_centavos_check"]
  }
  Note: "ACTUAL. valor_uvt_valor_centavos_check: CHECK ((valor_centavos > 0))\nINDICES FISICOS:\nCREATE UNIQUE INDEX valor_uvt_pkey ON nucleo.valor_uvt USING btree (anio)"
}

Table public.users {
  id uuid [pk, not null]
  email text [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (email) [unique, name: "users_email_key"]
  }
  Note: "ACTUAL. Legado congelado; nuevas identidades en auth.partes. \nINDICES FISICOS:\nCREATE UNIQUE INDEX users_email_key ON public.users USING btree (email)\nCREATE UNIQUE INDEX users_pkey ON public.users USING btree (id)"
}

Ref: asistente.accion_pendiente.(desafio_id) > auth.desafios.(id) [delete: no action]
Ref: asistente.accion_pendiente.(transferencia_id) > nucleo.transferencia.(id) [delete: no action]
Ref: asistente.accion_pendiente.(conversacion_id, usuario_id) > asistente.conversacion.(id, usuario_id) [delete: cascade]
Ref: asistente.conversacion.(usuario_id) > auth.partes.(id) [delete: no action]
Ref: asistente.mensaje.(conversacion_id, accion_id) > asistente.accion_pendiente.(conversacion_id, id) [delete: no action]
Ref: asistente.mensaje.(conversacion_id) > asistente.conversacion.(id) [delete: cascade]
Ref: asistente.mensaje.(conversacion_id, respuesta_a) > asistente.mensaje.(conversacion_id, id) [delete: no action]
Ref: asistente.solicitud_texto.(conversacion_id, mensaje_id) > asistente.mensaje.(conversacion_id, id) [delete: cascade]
Ref: asistente.solicitud_texto.(conversacion_id, usuario_id) > asistente.conversacion.(id, usuario_id) [delete: cascade]
Ref: auth.codigos_respaldo.(credencial_id) > auth.credenciales.(id) [delete: no action]
Ref: auth.consentimientos.(parte_id) > auth.partes.(id) [delete: no action]
Ref: auth.credenciales.(parte_id) > auth.partes.(id) [delete: no action]
Ref: auth.desafios.(parte_id) > auth.partes.(id) [delete: no action]
Ref: auth.empresas.(parte_id) > auth.partes.(id) [delete: no action]
Ref: auth.kyc_estados.(parte_id) > auth.partes.(id) [delete: no action]
Ref: auth.kyc_verificaciones.(parte_id) > auth.partes.(id) [delete: no action]
Ref: auth.personas.(parte_id) > auth.partes.(id) [delete: no action]
Ref: auth.roles_de_parte.(parte_id) > auth.partes.(id) [delete: no action]
Ref: auth.roles_de_parte.(representada_id) > auth.partes.(id) [delete: no action]
Ref: auth.sesiones.(parte_id) > auth.partes.(id) [delete: no action]
Ref: auth.tokens_restablecimiento.(credencial_id) > auth.credenciales.(id) [delete: no action]
Ref: auth.transiciones_credencial.(credencial_id) > auth.credenciales.(id) [delete: no action]
Ref: inteligencia.aviso_entrega.(aviso_id) > inteligencia.aviso.(id) [delete: cascade]
Ref: inteligencia.memoria_correccion.(categoria) > inteligencia.categoria.(codigo) [delete: no action]
Ref: inteligencia.movimiento_enriquecido.(categoria) > inteligencia.categoria.(codigo) [delete: no action]
Ref: nucleo.journal_entry.(deposito_id) > nucleo.deposito.(id) [delete: no action]
Ref: nucleo.posting.(cuenta_id) > nucleo.cuenta.(id) [delete: no action]
Ref: nucleo.posting.(entry_id) > nucleo.journal_entry.(id) [delete: no action]
Ref: nucleo.transferencia.(cuenta_origen) > nucleo.cuenta.(id) [delete: no action]

