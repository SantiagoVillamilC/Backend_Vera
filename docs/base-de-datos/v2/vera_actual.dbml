  prioridad smallint [not null]
  texto text [not null]
  texto_verificado boolean [not null, default: `false`]
  transaccion_id uuid
  creado_en timestamptz [not null, default: `now()`]
  descartado_en timestamptz
  indexes {
    (usuario_id, tipo, clave, periodo) [unique, name: "aviso_dedupe_unico"]
  }
  checks {
    `(btrim(clave) <> ''::text)` [name: "aviso_clave_check"]
    `((descartado_en IS NULL) OR (descartado_en >= creado_en))` [name: "aviso_descarte_no_anterior_al_alta"]
    `(prioridad > 0)` [name: "aviso_prioridad_check"]
    `(severidad_centavos >= 0)` [name: "aviso_severidad_centavos_check"]
    `(btrim(texto) <> ''::text)` [name: "aviso_texto_check"]
    `(btrim(tipo) <> ''::text)` [name: "aviso_tipo_check"]
    `(btrim(usuario_id) <> ''::text)` [name: "aviso_usuario_id_check"]
  }
  Note: "ACTUAL. aviso_clave_check: CHECK ((btrim(clave) <> ''::text))\naviso_descarte_no_anterior_al_alta: CHECK (((descartado_en IS NULL) OR (descartado_en >= creado_en)))\naviso_prioridad_check: CHECK ((prioridad > 0))\naviso_severidad_centavos_check: CHECK ((severidad_centavos >= 0))\naviso_texto_check: CHECK ((btrim(texto) <> ''::text))\naviso_tipo_check: CHECK ((btrim(tipo) <> ''::text))\naviso_usuario_id_check: CHECK ((btrim(usuario_id) <> ''::text))\nINDICES FISICOS:\nCREATE UNIQUE INDEX aviso_dedupe_unico ON inteligencia.aviso USING btree (usuario_id, tipo, clave, periodo)\nCREATE UNIQUE INDEX aviso_pkey ON inteligencia.aviso USING btree (id)\nCREATE INDEX aviso_por_usuario ON inteligencia.aviso USING btree (usuario_id, periodo DESC, prioridad, severidad_centavos DESC)\nCREATE INDEX aviso_vigente_por_usuario ON inteligencia.aviso USING btree (usuario_id, creado_en DESC) WHERE (descartado_en IS NULL)"
}

