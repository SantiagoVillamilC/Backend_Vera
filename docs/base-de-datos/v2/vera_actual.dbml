Table inteligencia.movimiento_enriquecido {
  usuario_id text [not null]
  transaccion_id uuid [not null]
  entry_ancla bigint [not null]
  ocurrido_en timestamptz [not null]
  moneda char(3) [not null, default: `'COP'::bpchar`]
  direccion text [not null]
  monto_centavos bigint [not null]
  contraparte text [not null]
  contraparte_resuelta boolean [not null]
  descripcion text
  categoria text [not null]
  origen_categoria text [not null]
  comercio_mid text
  comercio_nombre text
  mcc text
  version_modelo text [not null]
  calculado_en timestamptz [not null, default: `now()`]
  tipo_destino text
  contraparte_llave text
  contraparte_nombre_normalizado text
  indexes {
    (usuario_id, transaccion_id) [pk]
  }
  checks {
    `(btrim(contraparte) <> ''::text)` [name: "movimiento_enriquecido_contraparte_check"]
    `((tipo_destino IS NOT NULL) OR ((contraparte_llave IS NULL) AND (comercio_mid IS NULL) AND (contraparte_nombre_normalizado IS NULL)))` [name: "movimiento_enriquecido_destino_completo"]
    `(direccion = ANY (ARRAY['entrada'::text, 'salida'::text]))` [name: "movimiento_enriquecido_direccion_check"]
    `((contraparte_llave IS NULL) OR (btrim(contraparte_llave) <> ''::text))` [name: "movimiento_enriquecido_llave_no_vacia"]
    `(monto_centavos <> 0)` [name: "movimiento_enriquecido_monto_centavos_check"]
    `((contraparte_nombre_normalizado IS NULL) OR ((btrim(contraparte_nombre_normalizado) <> ''::text) AND (contraparte_nombre_normalizado = btrim(contraparte_nombre_normalizado))))` [name: "movimiento_enriquecido_nombre_normalizado_valido"]
    `((contraparte_nombre_normalizado IS NULL) OR (tipo_destino = 'comercio'::text))` [name: "movimiento_enriquecido_nombre_solo_de_comercio"]
    `(origen_categoria = ANY (ARRAY['memoria'::text, 'contraparte_interna'::text, 'mcc'::text, 'catalogo'::text, 'lexico'::text, 'tfidf'::text, 'llm'::text, 'sin_categoria'::text, 'manual'::text]))` [name: "movimiento_enriquecido_origen_categoria_check"]
    `((tipo_destino IS NULL) OR (tipo_destino = ANY (ARRAY['comercio'::text, 'persona'::text])))` [name: "movimiento_enriquecido_tipo_destino_valido"]
    `(btrim(usuario_id) <> ''::text)` [name: "movimiento_enriquecido_usuario_id_check"]
    `(btrim(version_modelo) <> ''::text)` [name: "movimiento_enriquecido_version_modelo_check"]
  }
  Note: "ACTUAL. movimiento_enriquecido_contraparte_check: CHECK ((btrim(contraparte) <> ''::text))\nmovimiento_enriquecido_destino_completo: CHECK (((tipo_destino IS NOT NULL) OR ((contraparte_llave IS NULL) AND (comercio_mid IS NULL) AND (contraparte_nombre_normalizado IS NULL))))\nmovimiento_enriquecido_direccion_check: CHECK ((direccion = ANY (ARRAY['entrada'::text, 'salida'::text])))\nmovimiento_enriquecido_llave_no_vacia: CHECK (((contraparte_llave IS NULL) OR (btrim(contraparte_llave) <> ''::text)))\nmovimiento_enriquecido_monto_centavos_check: CHECK ((monto_centavos <> 0))\nmovimiento_enriquecido_nombre_normalizado_valido: CHECK (((contraparte_nombre_normalizado IS NULL) OR ((btrim(contraparte_nombre_normalizado) <> ''::text) AND (contraparte_nombre_normalizado = btrim(contraparte_nombre_normalizado)))))\nmovimiento_enriquecido_nombre_solo_de_comercio: CHECK (((contraparte_nombre_normalizado IS NULL) OR (tipo_destino = 'comercio'::text)))\nmovimiento_enriquecido_origen_categoria_check: CHECK ((origen_categoria = ANY (ARRAY['memoria'::text, 'contraparte_interna'::text, 'mcc'::text, 'catalogo'::text, 'lexico'::text, 'tfidf'::text, 'llm'::text, 'sin_categoria'::text, 'manual'::text])))\nmovimiento_enriquecido_tipo_destino_valido: CHECK (((tipo_destino IS NULL) OR (tipo_destino = ANY (ARRAY['comercio'::text, 'persona'::text]))))\nmovimiento_enriquecido_usuario_id_check: CHECK ((btrim(usuario_id) <> ''::text))\nmovimiento_enriquecido_version_modelo_check: CHECK ((btrim(version_modelo) <> ''::text))\nINDICES FISICOS:\nCREATE UNIQUE INDEX movimiento_enriquecido_pkey ON inteligencia.movimiento_enriquecido USING btree (usuario_id, transaccion_id)\nCREATE INDEX movimiento_enriquecido_por_asiento ON inteligencia.movimiento_enriquecido USING btree (entry_ancla)\nCREATE INDEX movimiento_enriquecido_por_categoria ON inteligencia.movimiento_enriquecido USING btree (usuario_id, categoria, ocurrido_en)\nCREATE INDEX movimiento_enriquecido_por_destino_llave ON inteligencia.movimiento_enriquecido USING btree (usuario_id, tipo_destino, contraparte_llave) WHERE (contraparte_llave IS NOT NULL)\nCREATE INDEX movimiento_enriquecido_por_destino_mid ON inteligencia.movimiento_enriquecido USING btree (usuario_id, tipo_destino, comercio_mid) WHERE (comercio_mid IS NOT NULL)\nCREATE INDEX movimiento_enriquecido_por_destino_nombre ON inteligencia.movimiento_enriquecido USING btree (usuario_id, tipo_destino, contraparte_nombre_normalizado) WHERE (contraparte_nombre_normalizado IS NOT NULL)\nCREATE INDEX movimiento_enriquecido_por_usuario ON inteligencia.movimiento_enriquecido USING btree (usuario_id, ocurrido_en DESC, transaccion_id DESC)"
}

