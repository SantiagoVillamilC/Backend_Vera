# Banderas del destino produccion (infra/servidor/banderas.tsv).
# Solo banderas: secretos y el resto del entorno viven en .env.example.
# Documentación y verificación: docs/configuracion-entornos.md.
# producción deja el escalón 6 apagado: la medición de docs/medicion-tfidf-v3.md da 0,875 de
# precisión de lo mostrado, por debajo de la compuerta de 0,90 acordada.
CLASIFICADOR=apagado
LEXICO=apagado
AVISOS_ACTIVO=false
AVISOS_HORA=06:00
AVISOS_CUPO=3
VERA_PROVEEDOR=simulado
VERA_MODELO=
METRICAS_ACTIVO=false
ENRIQUECIMIENTO_INTERVAL=5m
